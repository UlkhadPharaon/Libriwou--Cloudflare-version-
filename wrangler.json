{
  "name": "neocompta-ai",
  "main": "src/worker.ts",
  "compatibility_date": "2024-03-20",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "vars": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENROUTER_CHAT_MODEL": "inclusionai/ling-3.0-flash-vl:free",
    "OPENROUTER_VISION_MODEL": "inclusionai/ling-3.0-flash-vl:free"
  },
  "kv_namespaces": [
    {
      "binding": "INTEL_CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
