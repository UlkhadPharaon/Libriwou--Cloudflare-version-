# GEMINI_API_KEY: Required for Gemini AI API calls (legacy - no longer used).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for NEO AI calls via OpenRouter.
# Get a key at https://openrouter.ai/keys then set it via .env (local) or Cloudflare Workers secrets.
# Model: inclusionai/ling-3.0-flash-vl:free (vision-capable, free tier)
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY_HERE"

# OPENROUTER_CHAT_MODEL: override for NEO chat/vision/intelligence/reference. Default is the VL free model below.
OPENROUTER_CHAT_MODEL="inclusionai/ling-3.0-flash-vl:free"
OPENROUTER_VISION_MODEL="inclusionai/ling-3.0-flash-vl:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# TAVILY_API_KEY: Required for web search in /api/intelligence
TAVILY_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BETA DEMO ACCOUNT — One-click tester login without Google/email
# The LandingPage "Accès Bêta-Testeur" button logs in via these credentials.
# Create the user in Firebase Console > Authentication > Add user BEFORE deploying.
# MUST be email/password provider. Mark as verified if you want to skip email verification.
# Default fallback (if unset): beta@libriwouo.bf / LibriwouoBeta2026!
VITE_BETA_EMAIL="beta@libriwouo.bf"
VITE_BETA_PASSWORD="LibriwouoBeta2026!"
