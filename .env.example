# GEMINI_API_KEY: Required for Gemini AI API calls (legacy - no longer used).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA NIM API calls (Nemotron 3.5 Lightning 30B).
# Configure this via Cloudflare Workers secrets or .env for local dev.
# Model: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY="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"

# NVIDIA_CHAT_MODEL: override for NEO chat. Default is the only valid tool-calling model for this account.
# Tested 2026-09-08: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning works (3s for salut, correct tool handling) with temp 0.3/max 900.
# BAD: nvidia/nemotron-3-nano-4b-a3b => 404, nvidia/nemotron-3.5-lightning-30b-a3b => 25s. Keep reasoning but fast-param.
NVIDIA_CHAT_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"

# TAVILY_API_KEY: Required for web search in /api/intelligence
TAVILY_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# BETA DEMO ACCOUNT — One-click tester login without Google/email
# The LandingPage "Accès Bêta-Testeur" button logs in via these credentials.
# Create the user in Firebase Console > Authentication > Add user BEFORE deploying.
# MUST be email/password provider. Mark as verified if you want to skip email verification.
# Default fallback (if unset): beta@libriwouo.bf / LibriwouoBeta2026!
VITE_BETA_EMAIL="beta@libriwouo.bf"
VITE_BETA_PASSWORD="LibriwouoBeta2026!"
