# GEMINI_API_KEY: Required for Gemini AI API calls (legacy - no longer used).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for NVIDIA NIM API calls (Nemotron 3.5 Lightning 30B).
# Configure this via Cloudflare Workers secrets or .env for local dev.
# Model: nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY="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"

# TAVILY_API_KEY: Required for web search in /api/intelligence
TAVILY_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
