# GEMINI_API_KEY: no longer used — the Gemini SDK was removed from the codebase.
# Left intentionally empty so nothing breaks if a stale reference reappears.
GEMINI_API_KEY=

# OPENROUTER_API_KEY: Required for NEO AI calls via OpenRouter.
# SERVER-SIDE ONLY. Never expose this in the client bundle (Règle 6).
# Get a key at https://openrouter.ai/keys then set it via .env (local) or Cloudflare Workers secrets:
#   wrangler secret put OPENROUTER_API_KEY
# Model: inclusionai/ling-3.0-flash-vl:free (vision-capable, free tier)
OPENROUTER_API_KEY="sk-or-v1-YOUR_OPENROUTER_KEY_HERE"

# OPENROUTER_CHAT_MODEL: override for NEO chat/vision/intelligence/reference. Default is the VL free model below.
OPENROUTER_CHAT_MODEL="inclusionai/ling-3.0-flash-vl:free"
OPENROUTER_VISION_MODEL="inclusionai/ling-3.0-flash-vl:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# TAVILY_API_KEY: SERVER-SIDE ONLY. Required for web search in /api/intelligence.
# Set as a Cloudflare secret: wrangler secret put TAVILY_API_KEY
TAVILY_API_KEY=

# APP_URL: The URL where this applet is hosted (used as OpenRouter HTTP-Referer).
APP_URL="MY_APP_URL"

# AI (BYOK — bring your own key)
#
# There is no server-side AI key anymore. Every request goes from the browser to the
# provider the user chooses, using the key they paste into
# Réglages → Fournisseur IA (stored encrypted on-device).
#
# The variables below only exist so `npm run dev` can be smoke-tested without typing
# a key. They are NEVER required, and never bundled anywhere except the local dev
# build, so leaving them empty is the correct production state.

# POSTHOG (Phase 5.2) — public project key, safe to expose (it is a client key by design).
# Analytics is a no-op until this is set and the user grants consent.
VITE_POSTHOG_KEY=""
VITE_POSTHOG_HOST="https://eu.i.posthog.com"

# Default provider/model shown the first time Réglages is opened (all optional).
VITE_AI_PROVIDER="openrouter"
VITE_AI_MODEL=""
